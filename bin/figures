#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["matplotlib>=3.8"]
# ///
"""Draw a study's figures from its `findings.csv` alone: bin/figures <study>.

- `figures/<table>-rates.png` for each leaderboard table: pooled pass rates with Wilson 95%
  intervals, drawn 16:9 for a slide. Entrants run along the bottom, smallest first, conditions
  side by side, in one panel per model shape (dense, MoE) from the catalogue.
- `figures/<table>-lift.png` for each version-board table: each version's lift over OFF, per model.

Run with `uv run --script`, which fetches matplotlib into a cached environment: plotting is never a
project dependency, and a study without figures still builds.
"""

from __future__ import annotations

import csv
import sys
from collections import defaultdict
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.lines
import matplotlib.pyplot as plt
import matplotlib.ticker

COLOURS = ["#1f4e79", "#c55a11", "#548235", "#7030a0", "#bf9000", "#2e75b6"]


def _float(value: str) -> float | None:
    return float(value) if value not in ("", None) else None


def _order(rows: list[dict[str, str]]) -> list[str]:
    """Models grouped by family, families by their smallest model, then by size and name."""
    smallest: dict[str, float] = {}
    for row in rows:
        size = _float(row["size_b"]) or float("inf")
        family = row["family"] or "~"
        smallest[family] = min(smallest.get(family, float("inf")), size)
    seen = {}
    for row in rows:
        family = row["family"] or "~"
        seen[row["entrant"]] = (smallest[family], family, _float(row["size_b"]) or float("inf"))
    return sorted(seen, key=lambda model: (*seen[model], model))


#: How each condition is drawn and named in a legend.
CONDITION_STYLE = {
    "off": ("#8c8c8c", "OFF: the bare model"),
    "routed": ("#c55a11", "ROUTED: the collection, found on its own"),
    "injected": ("#1f4e79", "INJECTED: the component in context"),
}
#: Panels of a rates figure, by the catalogue's `shape`, and the order they appear in.
SHAPES = {
    "dense": "Dense: every parameter used for every token",
    "moe": "MoE: only a few billion active per token",
}


def _panel(shape: str) -> str:
    if not shape:
        return "Not in the catalogue"
    return "moe" if "moe" in shape else shape


def _label(row: dict[str, str]) -> str:
    """The model without its provider, its size, and its setting when the entrant has one."""
    model = row["model"] or row["entrant"]
    # Name and tag on lines of their own, so twenty entrants fit across a slide.
    name, _, tag = model.split("/", 1)[-1].partition(":")
    lines = [f"{name}:", tag] if tag else [name]
    size = _float(row["size_b"])
    if size is not None:
        lines.append(f"{size:g}B")
    setting = row["entrant"].removeprefix(model).strip(" ()") if row["model"] else ""
    if setting:
        lines.append(setting)
    return "\n".join(lines)


def rates(table: str, rows: list[dict[str, str]], out: Path, title: str = "") -> Path | None:
    """Pass rates per entrant, conditions side by side, in one panel per model shape.

    Drawn at 16:9 for a slide: entrants run along the bottom, smallest first, so a figure with
    twenty entrants stays readable, and dense and MoE models sit in panels of their own.
    """
    pooled = [row for row in rows if not row["task"] and row["total"] not in ("", "0")]
    if not pooled:
        return None
    by_entrant = {row["entrant"]: row for row in pooled}
    panels: dict[str, list[str]] = defaultdict(list)
    for entrant in _order(pooled):
        panels[_panel(by_entrant[entrant].get("shape", ""))].append(entrant)
    for entrants in panels.values():
        entrants.sort(key=lambda e: (_float(by_entrant[e]["size_b"]) or float("inf"), e))
    names = [name for name in (*SHAPES, *sorted(set(panels) - set(SHAPES))) if name in panels]
    conditions = [c for c in CONDITION_STYLE if any(row["condition"] == c for row in pooled)]
    conditions += sorted({row["condition"] for row in pooled} - set(conditions))
    step = 0.7 / max(1, len(conditions))

    fig, axes = plt.subplots(
        1,
        len(names),
        # 16:9 at full width; narrower when a few entrants would leave a panel mostly empty.
        figsize=(min(13.33, 4 + 1.1 * sum(len(e) for e in panels.values())), 5.6),
        sharey=True,
        squeeze=False,
        gridspec_kw={"width_ratios": [len(panels[name]) + 0.6 for name in names]},
    )
    for ax, name in zip(axes[0], names, strict=True):
        entrants = panels[name]
        for index, condition in enumerate(conditions):
            colour, _ = CONDITION_STYLE.get(condition, (COLOURS[index % len(COLOURS)], condition))
            found = {row["entrant"]: row for row in pooled if row["condition"] == condition}
            xs, ys, low, high = [], [], [], []
            for place, entrant in enumerate(entrants):
                row = found.get(entrant)
                if row is None:
                    continue
                rate = float(row["rate"])
                xs.append(place + (index - (len(conditions) - 1) / 2) * step)
                ys.append(rate)
                low.append(rate - float(row["low"]))
                high.append(float(row["high"]) - rate)
            ax.errorbar(
                xs,
                ys,
                yerr=[low, high],
                fmt="o",
                color=colour,
                capsize=4,
                markersize=7,
                elinewidth=2,
            )
        ax.set_xticks(range(len(entrants)))
        ax.set_xticklabels([_label(by_entrant[e]) for e in entrants], fontsize=8.5)
        ax.set_xlim(-0.6, len(entrants) - 0.4)
        ax.set_title(SHAPES.get(name, name), fontsize=13)
        ax.grid(axis="y", alpha=0.3)
        for place in range(1, len(entrants)):
            ax.axvline(place - 0.5, color="#dddddd", linewidth=0.8)
    first = axes[0][0]
    first.set_ylim(-0.03, 1.03)
    first.yaxis.set_major_formatter(matplotlib.ticker.PercentFormatter(1.0))
    first.set_ylabel("pass rate, with Wilson 95% interval", fontsize=12)
    first.tick_params(axis="y", labelsize=11)
    handles = [
        matplotlib.lines.Line2D(
            [],
            [],
            color=CONDITION_STYLE.get(c, ("black", c))[0],
            marker="o",
            linestyle="",
            markersize=8,
        )
        for c in conditions
    ]
    fig.legend(
        handles,
        [CONDITION_STYLE.get(c, ("", c))[1] for c in conditions],
        loc="upper center",
        ncol=len(conditions),
        frameon=False,
        fontsize=12,
    )
    if title:
        fig.suptitle(title, x=0.01, ha="left", y=0.995, fontsize=10, color="#555555")
    fig.tight_layout(rect=(0, 0, 1, 0.94))
    path = out / f"{table}-rates.png"
    fig.savefig(path, dpi=150)
    plt.close(fig)
    return path


def lift(table: str, rows: list[dict[str, str]], out: Path) -> Path | None:
    entries = [row for row in rows if row["version"] and not row["task"] and row["lift"]]
    if not entries:
        return None
    models = _order(entries)
    versions = list(dict.fromkeys(row["version"] for row in entries))
    width = 0.8 / len(versions)
    fig, ax = plt.subplots(figsize=(max(6, 1.2 * len(models) * len(versions) / 2 + 2), 4.5))
    for index, version in enumerate(versions):
        found = {row["entrant"]: float(row["lift"]) for row in entries if row["version"] == version}
        xs = [place + index * width for place, model in enumerate(models) if model in found]
        ys = [found[model] for model in models if model in found]
        ax.bar(xs, ys, width=width, color=COLOURS[index % len(COLOURS)], label=version)
    ax.axhline(0, color="black", linewidth=0.8)
    ax.set_xticks([place + width * (len(versions) - 1) / 2 for place in range(len(models))])
    ax.set_xticklabels(models, rotation=30, ha="right")
    ax.set_ylabel("lift over OFF (pass rate)")
    ax.set_title(f"{table}: lift per version and model")
    ax.legend(loc="upper left", bbox_to_anchor=(1.01, 1), frameon=False)
    fig.tight_layout()
    path = out / f"{table}-lift.png"
    fig.savefig(path, dpi=200)
    plt.close(fig)
    return path


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("usage: bin/figures <study>", file=sys.stderr)
        return 2
    study = Path(argv[0])
    source = study / "findings.csv"
    if not source.is_file():
        print(f"no {source}: run `wikiskill findings tables {study}` first", file=sys.stderr)
        return 1
    tables: dict[tuple[str, str], list[dict[str, str]]] = defaultdict(list)
    with source.open(encoding="utf-8") as handle:
        for row in csv.DictReader(handle):
            tables[(row["table"], row["kind"])].append(row)
    out = study / "figures"
    out.mkdir(exist_ok=True)
    for (table, kind), rows in tables.items():
        drawn = (
            rates(table, rows, out, f"{study.name} · {table}")
            if kind == "leaderboard"
            else lift(table, rows, out)
            if kind == "version-board"
            else None
        )
        if drawn:
            print(f"wrote {drawn}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
