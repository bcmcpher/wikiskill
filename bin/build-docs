#!/usr/bin/env python3
"""Build a study's office documents from its markdown: bin/build-docs <study>.

`report.md` becomes `report.docx`, and `slides.md` becomes `slides.pptx`, one slide per `##`
heading, with `::: notes` blocks as speaker notes. A line reading

    <!-- include: tables/sweep.slim.md -->

is replaced by that file, relative to the document, so the generated tables are never copied by
hand. `reference.docx` and `reference.pptx` in the study style the output; without them, the
shared templates in `docs/findings/` do (a 16:9 `reference.pptx`).

The office files are build outputs and are not tracked: the markdown is the record. Pandoc must be
on PATH; without it, or with an include that does not exist, nothing is written.
"""

from __future__ import annotations

import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

INCLUDE = re.compile(r"^<!--[ \t]*include:[ \t]*(\S+)[ \t]*-->[ \t]*$", re.M)
#: GitHub renders a list that follows a paragraph line directly; pandoc's markdown needs this to.
READER = "--from=markdown+lists_without_preceding_blankline"
GENERATED = re.compile(r"^<!-- generated by .*-->\n\n?", re.M)
#: Templates every study shares unless it has its own: `reference.pptx` is 16:9 at 10 x 5.625 in,
#: the size Google Slides uses for widescreen.
SHARED = Path(__file__).resolve().parent.parent / "docs" / "findings"
DOCUMENTS = (("report.md", "report.docx", ()), ("slides.md", "slides.pptx", ("--slide-level=2",)))


class BuildError(Exception):
    pass


def expand(path: Path, seen: tuple[Path, ...] = ()) -> str:
    """The document with every include replaced, recursively, refusing a missing or circular one."""
    text = path.read_text(encoding="utf-8")

    def included(match: re.Match[str]) -> str:
        target = (path.parent / match[1]).resolve()
        if target in seen:
            raise BuildError(f"{path}: include {match[1]} includes itself")
        if not target.is_file():
            raise BuildError(f"{path}: include {match[1]} does not exist")
        return GENERATED.sub("", expand(target, (*seen, target))).strip("\n")

    return INCLUDE.sub(included, text)


def _reference(study: Path, suffix: str) -> Path | None:
    """The study's own template, else the shared one in `docs/findings`, else pandoc's default."""
    for candidate in (study / f"reference{suffix}", SHARED / f"reference{suffix}"):
        if candidate.is_file():
            return candidate
    return None


def build(study: Path) -> list[Path]:
    pandoc = shutil.which("pandoc")
    if pandoc is None:
        raise BuildError("pandoc is not on PATH; install it (e.g. `sudo apt install pandoc`)")
    wanted = [(study / src, study / out, extra) for src, out, extra in DOCUMENTS]
    wanted = [(src, out, extra) for src, out, extra in wanted if src.is_file()]
    if not wanted:
        raise BuildError(f"{study} has neither report.md nor slides.md")
    # Every include is expanded before anything is written, so one bad include writes nothing.
    expanded = [(expand(src), src, out, extra) for src, out, extra in wanted]
    written = []
    with tempfile.TemporaryDirectory() as scratch:
        for text, src, out, extra in expanded:
            source = Path(scratch) / src.name
            source.write_text(text, encoding="utf-8")
            partial = Path(scratch) / out.name
            command = [pandoc, str(source), READER, "-o", str(partial), f"--resource-path={study}"]
            command += extra
            reference = _reference(study, out.suffix)
            if reference is not None:
                command.append(f"--reference-doc={reference}")
            done = subprocess.run(command, capture_output=True, text=True, check=False)
            if done.returncode != 0:
                raise BuildError(f"pandoc failed on {src}: {done.stderr.strip()}")
            written.append((partial, out))
        for partial, out in written:
            shutil.move(partial, out)
    version = subprocess.run([pandoc, "--version"], capture_output=True, text=True, check=False)
    (study / "build.txt").write_text(version.stdout.splitlines()[0] + "\n", encoding="utf-8")
    return [out for _, out in written]


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("usage: bin/build-docs <study>", file=sys.stderr)
        return 2
    try:
        for path in build(Path(argv[0])):
            print(f"wrote {path}")
    except BuildError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
